# Cách 1 (khuyến nghị): cookie phiên "li_at" lấy từ trình duyệt đã đăng nhập LinkedIn
LINKEDIN_LI_AT=

# Cách 2: đăng nhập bằng tài khoản (có thể bị yêu cầu xác minh 2FA/captcha -> dùng --headful để tự xử lý)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Giới hạn an toàn để tránh bị LinkedIn khóa tài khoản
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=20
MAX_PROFILES_PER_RUN=80
HEADLESS=true

# Tuỳ chọn: dùng Chrome có sẵn thay cho Chromium của Playwright
CHROMIUM_EXECUTABLE=
